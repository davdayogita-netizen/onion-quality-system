# Database: PostgreSQL (or fallback to SQLite if PostgreSQL not running)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/onion_quality

# Machine Learning & Inference Settings
INFERENCE_MODE=demo
MODEL_VERSION=v1.0.0-demo
YOLO_MODEL_PATH=models/yolo/onion_yolo.pt
CLASSIFIER_MODEL_PATH=models/classifier/onion_classifier.pt

# File Storage
UPLOAD_DIR=uploads
REPORT_DIR=reports

# Server & CORS
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
